generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int        @id @default(autoincrement())
  email          String     @unique @db.VarChar(100)
  password       String     @db.VarChar(255)
  name           String     @db.VarChar(100)
  address        String?    @db.VarChar(255)
  avatarUrl      String?    @map("avatar_url") @db.VarChar(255)
  token          String?    @db.VarChar(512)
  tokenExpiresAt DateTime?  @map("token_expires_at")
  otp            String?    @db.VarChar(6)
  otpExpiresAt   DateTime?  @map("otp_expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @default(now()) @map("updated_at")
  Cart           Cart[]
  Order          Order[]
  Payment        Payment[]
  Review         Review[]
  TryonSet       TryonSet[]

  @@map("users")
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String     @unique @db.VarChar(100)
  description String?    @db.Text
  parentId    Int?       @map("parent_id")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  parent      Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryToCategory")
  products    Product[]

  @@index([parentId], map: "categories_parent_id_fkey")
  @@map("categories")
}

model Product {
  id             Int            @id @default(autoincrement())
  name           String         @db.VarChar(100)
  description    String?        @db.Text
  price          Float
  categoryId     Int            @map("category_id")
  gender         String?        @db.VarChar(10)
  availableSizes String?        @map("available_sizes") @db.VarChar(50)
  color          String?        @db.VarChar(30)
  imageUrl       String?        @map("image_url") @db.VarChar(255)
  arModelUrl     String?        @map("ar_model_url") @db.VarChar(255)
  ratingAvg      Float          @default(0) @map("rating_avg")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  cartItems      CartItem[]
  orderItems     OrderItem[]
  category       Category       @relation(fields: [categoryId], references: [id])
  reviews        Review[]
  tryonSetItems  TryonSetItem[]

  @@index([categoryId], map: "products_category_id_fkey")
  @@map("products")
}

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  productId Int      @map("product_id")
  rating    Int      @default(0)
  content   String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@index([productId], map: "reviews_product_id_fkey")
  @@index([userId], map: "reviews_user_id_fkey")
  @@map("reviews")
}

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int        @map("user_id")
  createdAt DateTime   @default(now()) @map("created_at")
  cartItems CartItem[]
  user      User       @relation(fields: [userId], references: [id])

  @@index([userId], map: "carts_user_id_fkey")
  @@map("carts")
}

model CartItem {
  id        Int     @id @default(autoincrement())
  cartId    Int     @map("cart_id")
  productId Int     @map("product_id")
  quantity  Int     @default(1)
  size      String? @db.VarChar(10)
  price     Float?
  cart      Cart    @relation(fields: [cartId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([cartId], map: "cart_items_cart_id_fkey")
  @@index([productId], map: "cart_items_product_id_fkey")
  @@map("cart_items")
}

model Order {
  id           Int         @id @default(autoincrement())
  userId       Int         @map("user_id")
  total        Float?
  usedPoints   Int         @default(0) @map("used_points")
  earnedPoints Int         @default(0) @map("earned_points")
  status       String      @default("PENDING") @db.VarChar(20)
  createdAt    DateTime    @default(now()) @map("created_at")
  orderItems   OrderItem[]
  user         User        @relation(fields: [userId], references: [id])
  payments     Payment[]

  @@index([userId], map: "orders_user_id_fkey")
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int     @map("order_id")
  productId Int     @map("product_id")
  quantity  Int?
  size      String? @db.VarChar(10)
  price     Float?
  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([orderId], map: "order_items_order_id_fkey")
  @@index([productId], map: "order_items_product_id_fkey")
  @@map("order_items")
}

model Payment {
  id            Int       @id @default(autoincrement())
  orderId       Int       @map("order_id")
  userId        Int       @map("user_id")
  method        String    @db.VarChar(50)
  amount        Float
  status        String    @default("PENDING") @db.VarChar(20)
  transactionId String?   @map("transaction_id") @db.VarChar(100)
  paidAt        DateTime? @map("paid_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  order         Order     @relation(fields: [orderId], references: [id])
  user          User      @relation(fields: [userId], references: [id])

  @@index([orderId], map: "payments_order_id_fkey")
  @@index([userId], map: "payments_user_id_fkey")
  @@map("payments")
}

model TryonSet {
  id          Int            @id @default(autoincrement())
  userId      Int            @map("user_id")
  name        String?        @db.VarChar(100)
  snapshotUrl String?        @map("snapshot_url") @db.VarChar(255)
  createdAt   DateTime       @default(now()) @map("created_at")
  items       TryonSetItem[]
  user        User           @relation(fields: [userId], references: [id])

  @@index([userId], map: "tryon_sets_user_id_fkey")
  @@map("tryon_sets")
}

model TryonSetItem {
  id        Int      @id @default(autoincrement())
  setId     Int      @map("set_id")
  productId Int      @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])
  set       TryonSet @relation(fields: [setId], references: [id])

  @@index([productId], map: "tryon_set_items_product_id_fkey")
  @@index([setId], map: "tryon_set_items_set_id_fkey")
  @@map("tryon_set_items")
}
