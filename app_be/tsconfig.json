{
  "compilerOptions": {
    // Input / Output
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment (Node.js)
    "target": "ES2023",
    "module": "commonjs",
    "moduleResolution": "node",
    "types": ["node"],

    // Helpful features
    "sourceMap": true,
    "removeComments": true,

    // Strict mode
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "forceConsistentCasingInFileNames": true,

    // Import compatibility
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,

    // Build performance
    "skipLibCheck": true,

    // Type roots (được merge từ main)
    "typeRoots": ["./src/types", "./node_modules/@types"]
  },

  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/generated"]
}
